# Copie este arquivo para .env (raiz). É lido pela coleta Python.
# NUNCA versione o .env.

# Token do Apify (https://console.apify.com/account/integrations).
# Sem token, a coleta usa o fallback sintético de coleta/gerar_mock.py.
APIFY_TOKEN=apify_api_seu_token_aqui

# Páginas monitoradas
AGR_INSTAGRAM_URL="https://www.instagram.com/agrgoias/"
AGR_GOOGLE_MAPS_URL="https://www.google.com/maps/place/AGR+-+Ag%C3%AAncia+Goiana+de+Regula%C3%A7%C3%A3o,+Controle+e+Fiscaliza%C3%A7%C3%A3o+de+Servi%C3%A7os+P%C3%BAblicos/@-16.674483,-49.2620082,540m/data=!3m1!1e3!4m8!3m7!1s0x935ef165d5ee7c1b:0x45fa9798dad53b14!8m2!3d-16.6771466!4d-49.2577108!9m1!1b1!16s%2Fg%2F1pw3ytrlb?entry=ttu&g_ep=EgoyMDI2MTExNS4wIKXMDSoASAFQAw%3D%3D"

# Limites de coleta (controlam custo no Apify)
INSTAGRAM_POSTS_LIMIT=50
GOOGLE_MAX_REVIEWS=50
