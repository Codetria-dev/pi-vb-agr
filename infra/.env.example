# Copie este arquivo para infra/.env e ajuste os valores.
# O docker compose lê infra/.env automaticamente.
# O APIFY_TOKEN fica no .env da raiz (lido pela coleta Python), não aqui.

# Chave de assinatura de sessão do Superset (use algo longo e aleatório).
SUPERSET_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-bem-longa

# Usuário administrador criado no primeiro start.
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_ADMIN_EMAIL=admin@agr.local
